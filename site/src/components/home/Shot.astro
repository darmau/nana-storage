---
// 应用截图：src/assets/screenshots/{id}-{light|dark}-{zh|en}.png（site/scripts/screenshots.mjs 生成）。
// 浅色 / 深色各一张，随主题切换；没有截图时（人物、相似照片这些本地截不到的）显示 CSS 画的示意图。
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Mock from "./Mock.astro";

interface Props {
	id: string;
	lang: "zh" | "en";
	alt: string;
	/** 首屏大图：优先加载。 */
	eager?: boolean;
	widths?: number[];
	sizes?: string;
	mockNote: string;
	/** 放大到截图里的某一块（卡片很小时裁掉侧边栏），origin 是 CSS transform-origin。 */
	focus?: { zoom: number; origin: string };
}
const { id, lang, alt, eager = false, widths = [480, 800, 1200], sizes = "(min-width: 960px) 440px, 100vw", mockNote, focus } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("../../assets/screenshots/*.webp", { eager: true });
const pick = (theme: string) =>
	(files[`../../assets/screenshots/${id}-${theme}-${lang}.webp`] ?? files[`../../assets/screenshots/${id}-${theme}-zh.webp`])?.default;
const light = pick("light");
const dark = pick("dark") ?? light;
const loading = eager ? "eager" : "lazy";
---

{
	light && dark ? (
		<div class="shot" style={focus ? `--zoom:${focus.zoom};--origin:${focus.origin}` : undefined}>
			<Image class="only-light" src={light} alt={alt} widths={widths} sizes={sizes} format="webp" quality={82} loading={loading} />
			<Image class="only-dark" src={dark} alt={alt} widths={widths} sizes={sizes} format="webp" quality={82} loading={loading} />
		</div>
	) : (
		<div class="shot shot-mock" role="img" aria-label={`${alt} (${mockNote})`}>
			<Mock kind={id} />
		</div>
	)
}
